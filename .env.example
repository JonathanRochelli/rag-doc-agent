# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modèle Claude utilisé pour générer les réponses.
# claude-opus-5   -> le plus capable (par défaut)
# claude-sonnet-5 -> bon compromis qualité/coût
# claude-haiku-4-5 -> le moins cher, pour les démos à fort volume
CLAUDE_MODEL=claude-opus-5
